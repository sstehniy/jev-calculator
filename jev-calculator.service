[Unit]
Description=Jev calculator
After=docker.service network-online.target
Requires=docker.service

[Service]
Restart=always
RestartSec=5
TimeoutStopSec=20
ExecStart=/usr/bin/docker run --rm --name jev-calculator --init --user 10000:10000 --read-only --cap-drop ALL --security-opt no-new-privileges --cpus 1 --memory 512m --memory-swap 512m --pids-limit 128 --ulimit nofile=1024:1024 --tmpfs /tmp:rw,noexec,nosuid,size=16m --log-opt max-size=5m --log-opt max-file=2 --env-file /etc/jev-calculator.env -p 127.0.0.1:3217:3217 -v /var/lib/jev-calculator:/data:rw jev-calculator:latest
ExecStop=/usr/bin/docker stop --time 10 jev-calculator

[Install]
WantedBy=multi-user.target
